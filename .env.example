# === Core ===
DATABASE_URL=sqlite:///saw.db
SAW_LOG_LEVEL=INFO
SAW_DEBUG=false

# === LLM Providers (at least one required) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LITELLM_API_KEY=

# === Authentication (REQUIRED in production) ===
AUTH_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Encryption (REQUIRED in production) ===
SAW_ENCRYPTION_KEY=

# === Rate Limiting ===
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_HOUR=100
RATE_LIMIT_DAY=1000
RATE_LIMIT_ENABLED=true

# === Database Pool ===
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# === GitHub Integration ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# === Other Connectors ===
NOTION_CLIENT_SECRET=
SLACK_CLIENT_SECRET=
SAW_SLACK_SIGNING_SECRET=
SAW_DISCORD_PUBLIC_KEY=
FEISHU_CLIENT_SECRET=
SAW_FEISHU_SIGNING_SECRET=
